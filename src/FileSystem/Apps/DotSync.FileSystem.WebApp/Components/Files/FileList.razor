@rendermode InteractiveServer

@if (Files == null || Files.Count == 0)
{
  <b>No result</b>
}
else
{
  var i = 0;
  <div class="accordion" id="file-list-accordion">
    @foreach (var fileList in Files)
    {
      var id = "file-list-accordion-" + i;
      var colCount = fileList.Value.FirstOrDefault()?.Length ?? 0;

      <div class="accordion-item">
        <h2 class="accordion-header">
          <button class="accordion-button" type="button" data-bs-toggle="collapse"
                  data-bs-target="#@id" aria-expanded="true"
                  aria-controls="@id">
            @fileList.Key
          </button>
        </h2>
        <div id="@id" class="accordion-collapse collapse show">
          <div class="accordion-body">
            <table class="table">
              <thead>
              <tr>
                @for (var j = 0; j < colCount; j++)
                {
                  <th scope="col"></th>
                }
              </tr>
              </thead>
              <tbody>
              @foreach (var file in fileList.Value)
              {
                <tr>
                  @foreach (var col in file)
                  {
                    <td>@col</td>
                  }
                </tr>
              }
              </tbody>
            </table>
          </div>
        </div>
      </div>
      i++;
    }
  </div>
}

@if (ShowClear)
{
  <div class="container">
    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Clear">Clear</button>
  </div>
}

@code {
  [Parameter] public Dictionary<string, IReadOnlyList<string[]>>? Files { get; set; }
  [Parameter] public bool ShowClear { get; set; } = true;

  private void Clear() => Files?.Clear();
}