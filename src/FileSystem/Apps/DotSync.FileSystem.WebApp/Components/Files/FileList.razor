@rendermode InteractiveServer

@if (Files == null || Files.Count == 0)
{
    <b>No result</b>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th scope="col">File</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var file in Files)
        {
            <tr>
                <td>@file</td>
            </tr>
        }
        </tbody>
    </table>
}
<div class="container">
    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Clear">Clear</button>
</div>

@code {
    [Parameter] public List<string>? Files { get; set; }

    private void Clear() => Files?.Clear();
}