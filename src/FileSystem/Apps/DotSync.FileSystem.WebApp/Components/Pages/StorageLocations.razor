@page "/Storage"
@rendermode InteractiveServer
@using com.brettnamba.DotSync.FileSystem.Domain.FileSystems.ValueObjects
@using com.brettnamba.DotSync.FileSystem.Domain.StorageLocations.Entities
@using com.brettnamba.DotSync.FileSystem.Domain.StorageLocations.Enums
@using com.brettnamba.DotSync.FileSystem.Infrastructure.StorageLocations.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@inject IDbContextFactory<StorageLocationsDbContext> StorageDbContextFactory
@inject IJSRuntime JS
@attribute [Authorize]

<div class="container">
    <h3>Storage Locations</h3>
</div>

<div class="container">
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#storageModal">
        New
    </button>
</div>

<div class="container">
    <table class="table">
        <thead>
        <tr>
            <th scope="col">Type</th>
            <th scope="col">Path</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var storageLocation in _storageLocations)
        {
            <tr>
                <td>@storageLocation.Type</td>
                <td>@storageLocation.Path.Value</td>
            </tr>
        }
        </tbody>
    </table>
</div>


<div class="modal fade" id="storageModal" tabindex="-1" aria-labelledby="storageModal" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5">New Storage Location</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="container" id="storage-alert"></div>
                <EditForm Model="NewStorageModel" FormName="NewStorage">
                    <div class="mb-3">
                        <label class="form-label">Type:</label>
                        <InputSelect @bind-Value="NewStorageModel!.Type" class="form-control">
                            <option value="@StorageLocationType.Local">Local</option>
                            <option value="@StorageLocationType.AmazonS3">S3</option>
                        </InputSelect>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Path:</label>
                        <InputText @bind-Value="NewStorageModel!.Path" class="form-control"/>
                    </div>
                </EditForm>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" @onclick="Create">Save changes</button>
            </div>
        </div>
    </div>
</div>

@code {
    private StorageLocationsDbContext _dbContext = null!;
    private List<StorageLocation> _storageLocations = new List<StorageLocation>();
    private IJSObjectReference? _module;

    [SupplyParameterFromForm(FormName = "NewStorage")]
    private StorageModel? NewStorageModel { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/scripts.js");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        NewStorageModel ??= new StorageModel()
        {
            Type = StorageLocationType.Local,
            Path = ""
        };
        _dbContext = await StorageDbContextFactory.CreateDbContextAsync();
        _storageLocations = await _dbContext.StorageLocations.ToListAsync();
    }

    private async Task Create()
    {
        if (NewStorageModel == null || string.IsNullOrWhiteSpace(NewStorageModel.Path))
        {
            await _module!.InvokeVoidAsync("showAlert", "storage-alert", "danger", "Path is required!");
            return;
        }

        await _dbContext.StorageLocations.AddAsync(new StorageLocation(NewStorageModel.Type, FileSystemPath.Create(NewStorageModel.Path)));
        await _dbContext.SaveChangesAsync();
        await _module!.InvokeVoidAsync("closeModal", "storageModal");
    }

    public class StorageModel
    {
        public StorageLocationType Type { get; set; }
        public string Path { get; set; } = null!;
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

}
