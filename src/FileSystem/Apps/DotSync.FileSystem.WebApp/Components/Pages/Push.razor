@page "/Push"
@inject JobComponent JobComponent
@using System.ComponentModel.DataAnnotations
@using com.brettnamba.DotSync.FileSystem.Application.Jobs
@using com.brettnamba.DotSync.FileSystem.Application.Orchestration
@using com.brettnamba.DotSync.FileSystem.Domain.FileSystems.Enums
@using com.brettnamba.DotSync.FileSystem.Infrastructure.Jobs.Parameters
@using com.brettnamba.DotSync.FileSystem.WebApp.Components.Files
@using com.brettnamba.DotSync.FileSystem.WebApp.Components.Jobs
@using com.brettnamba.DotSync.FileSystem.WebApp.Components.Widgets
@using com.brettnamba.DotSync.FileSystem.WebApp.Startup
@using Microsoft.AspNetCore.Authorization
@implements IDisposable
@rendermode InteractiveServer
@attribute [Authorize(AuthenticationExtensions.PusherPolicy)]

<div class="container">
    <h3>Push</h3>
</div>

<div class="container">
    <EditForm Model="PushModel" OnSubmit="ExecutePush" FormName="Push">
        <div class="mb-3">
            <label class="form-label">Source Root Path:</label>
            <InputText @bind-Value="PushModel!.SourceRootPath" class="form-control"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Source Push Path:</label>
            <FilePathInput @bind-Text="PushModel!.SourcePushPath"/>
        </div>
        <div class="input-group mb-3">
            <label class="input-group-text">Destination Type</label>
            <InputSelect @bind-Value="PushModel!.DestinationType" class="form-select">
                @foreach (var t in Enum.GetValues<StorageLocationType>())
                {
                    <option value="@t">@t</option>
                }
            </InputSelect>
        </div>
        <div class="mb-3">
            <label class="form-label">Destination Path:</label>
            <InputText @bind-Value="PushModel!.DestinationPath" class="form-control"/>
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </EditForm>
</div>

<hr/>

<div class="container">
    <ProgressBar Value="@_progressPercent"/>
</div>
<div class="container">
    <JobProgress Messages="@_progressMessages"/>
</div>

<hr/>

@code {
    private const JobType JobId = JobType.Push;

    [SupplyParameterFromForm(FormName = "Push")]
    private PushForm? PushModel { get; set; }

    private double _progressPercent = 0;
    private readonly List<string> _progressMessages = new List<string>();
    private IReadOnlyList<FileResultList>? _result;

    protected override void OnInitialized()
    {
        JobComponent.OnInitialized();

        //JobComponent.JobResultProvider.JobCompleted += ParseResult;
        JobComponent.ProgressReporter.LogReported += ReportProgressLog;
        JobComponent.ProgressReporter.PercentReported += ReportProgressPercent;
        PushModel ??= new PushForm()
        {
            SourceRootPath = JobComponent.DefaultLocalStorage,
            DestinationType = StorageLocationType.AmazonS3,
            DestinationPath = JobComponent.DefaultS3Storage
        };
    }

    private void ExecutePush()
    {
        _progressPercent = 0;
        JobComponent.Logger.LogInformation($"Pushing {PushModel!.SourceRootPath} {PushModel.SourcePushPath} to {PushModel.DestinationType} {PushModel.DestinationPath}");
        _ = Task.Run(() => JobComponent.JobManager.RunJob(new PushParameters(PushModel.SourceRootPath, PushModel.SourcePushPath, PushModel.DestinationType, PushModel.DestinationPath)));
    }

    // private void ParseResult(object? sender, IJobOutput data)
    // {
    //     if (JobId != data.JobParameters.Type) return;
    //     if (data.JobParameters is not PushParameters)
    //     {
    //         throw new ArgumentException("Invalid parameters");
    //     }
    //
    //     _result = new List<FileResultList>()
    //     {
    //         new("Files", (data.Result as IEnumerable<DotFile> ?? []).Select(x => (string[])[x.Path.Value]).ToImmutableList(), true)
    //     }.AsReadOnly();
    //
    //     InvokeAsync(StateHasChanged);
    //     _progressMessages.Clear();
    // }

    private void ReportProgressLog(object? sender, ProgressLog log)
    {
        _progressMessages.Add(log.Message);
        InvokeAsync(StateHasChanged);
    }

    private void ReportProgressPercent(object? sender, ProgressPercent percent)
    {
        _progressPercent = percent.AsPercent();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        //JobComponent.JobResultProvider.JobCompleted -= ParseResult;
        JobComponent.ProgressReporter.LogReported -= ReportProgressLog;
        JobComponent.ProgressReporter.PercentReported -= ReportProgressPercent;
        JobComponent.Dispose();
    }

    public class PushForm
    {
        public string SourceRootPath { get; set; } = null!;
        public string SourcePushPath { get; set; } = null!;

        [Required, EnumDataType(typeof(StorageLocationType))]
        public StorageLocationType DestinationType { get; set; }

        public string DestinationPath { get; set; } = null!;
    }

}