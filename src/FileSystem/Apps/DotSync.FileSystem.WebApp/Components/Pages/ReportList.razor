@inject IWebHostEnvironment WebHostEnvironment
@page "/Reports"

<div class="container">
    <h3>Reports</h3>
</div>

<table class="table">
    <thead>
    <tr>
        <th scope="col">Report</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var file in _reports.OrderByDescending(x => x))
    {
        <tr>
            <td><a href="/Report?File=@Path.GetFileName(file)">@Path.GetFileName(file)</a></td>
        </tr>
    }
    </tbody>
</table>

@code {

    private List<string> _reports = new List<string>();

    protected override void OnInitialized()
    {
        var reportPath = Path.Combine(WebHostEnvironment.WebRootPath, "reports");
        _reports = Directory.EnumerateFiles(reportPath).ToList();
    }

}