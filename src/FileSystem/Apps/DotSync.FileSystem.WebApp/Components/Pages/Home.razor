@page "/"
@page "/files"
@using System.Collections.Immutable
@using System.Web
@using com.brettnamba.DotSync.FileSystem.Application.Storage
@using com.brettnamba.DotSync.FileSystem.Domain.FileSystems.Entities
@using com.brettnamba.DotSync.FileSystem.Domain.FileSystems.ValueObjects
@using com.brettnamba.DotSync.FileSystem.Infrastructure.FileSystems.EntityFrameworkCore
@using com.brettnamba.DotSync.FileSystem.Infrastructure.Jobs.Parameters
@using com.brettnamba.DotSync.FileSystem.WebApp.Components.Files
@using com.brettnamba.DotSync.FileSystem.WebApp.Components.Jobs
@using Microsoft.AspNetCore.Components.QuickGrid
@using Microsoft.EntityFrameworkCore
@using SortDirection = Microsoft.AspNetCore.Components.QuickGrid.SortDirection
@rendermode InteractiveServer
@inject IDbContextFactory<FileSystemsDbContext> DbContextFactory
@inject JobComponent JobComponent
@inject IJSRuntime JS
@inject IMainStorageProvider MainStorageProvider

<AuthorizeView Context="authContext">
    <h1>Files</h1>
    <h3>Filter</h3>
    <div class="row align-items-center mb-2">
        <div class="col-sm-1">
            <label class="col-form-label">Prefix</label>
        </div>
        <div class="col-sm-11">
            <FilePathInput TextChanged="@(s => _searchQuery = s)"/>
        </div>
    </div>
    <div class="row align-items-center mb-2">
        <div class="col-sm-1">
            <label class="col-form-label">Unsynced Files</label>
        </div>
        <div class="col-sm-11">
            @{
                var storageCount = 0;
            }
            @foreach (var storage in _storageLocations)
            {
                if (_mainStoragePath == storage.Path) continue;
                <input type="radio" class="btn-check" name="storage_location" id="@($"storage_{storageCount}")"
                       autocomplete="off" @onchange="ChangeStorageLocation" value="@(storage.Id)">
                <label class="btn btn-sm btn-outline-dark mb-2"
                       for="@($"storage_{storageCount}")">@($"{storage.Type} - {storage.Path.Value}")</label>
                storageCount++;
            }
            @if (IsPageFilteredByStorageLocation())
            {
                <input type="radio" class="btn-check" name="storage_location" id="@($"storage_{storageCount}")"
                       autocomplete="off" @onchange="ChangeStorageLocation" value="@(Guid.Empty)">
                <label class="btn btn-sm btn-outline-dark mb-2 me-1" for="@($"storage_{storageCount}")">x</label>
            }
        </div>
    </div>
    @{
        var classAppend = !IsPageFilteredByStorageLocation() ? " d-none" : "";
    }
    <div class="row align-items-center mb-2 @(classAppend)">
        <div class="col-sm-1">
            <label class="col-form-label">Upload limit</label>
        </div>
        <div class="col-sm-1">
            <input type="number" min="0" @bind="_uploadLimit" class="form-control" aria-label="Upload limit"/>
        </div>
        <div class="col-sm-3">
            <span class="form-text me-2">
                MB
            </span>
            <button type="button" class="btn btn-primary" id="upload-btn" @onclick="OnClickUpload">Upload</button>
        </div>
    </div>

    <QuickGrid TGridItem="DotFile" ItemsProvider="FilterFiles" Pagination="_pagination" Class="table table-hover">
        <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn Title="" Sortable="false" Class="col-2 text-center">
            @{
                var encodedPath = HttpUtility.UrlEncode(context.Path.Value);
            }
            @if (IsImage(context.Path.Value))
            {
                <a href="#" data-bs-toggle="modal" data-bs-target="#modalPreview"
                   @onclick="@(e => OnThumbnailClicked(e, encodedPath))">
                    <img src="@(GetThumbnailUrl(encodedPath))" class="file-thumbnail rounded"
                         alt="@context.Path.Value"/>
                </a>
            }
            else
            {
                <i class="bi bi-file-earmark fs-1"></i>
            }
            <small><a href="file?path=@(encodedPath)" target="_blank" class="small">Download</a></small>
        </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
        <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn Class="col-8 text-left" Title="Path" Sortable="true"
                                                                  SortBy="@(GridSort<DotFile>.ByAscending(item => item.Path))">
            <small>@context.Path.Value</small>
        </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>

        <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn Class="col-1" Title="Created" Sortable="true"
                                                                  SortBy="@(GridSort<DotFile>.ByAscending(item => item.FileCreation))"
                                                                  IsDefaultSortColumn="true"
                                                                  InitialSortDirection="SortDirection.Descending">
            <small>@context.FileCreation.ToString("g")</small>
        </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
        <Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn Class="col-1" Title="First Sync" Sortable="true"
                                                                  SortBy="@(GridSort<DotFile>.ByAscending(item => item.FirstSync))">
            <small>@context.FirstSync.ToString("g")</small>
        </Microsoft.AspNetCore.Components.QuickGrid.TemplateColumn>
    </QuickGrid>

    <Paginator State="_pagination"/>
    <div class="container-fluid text-left">
        <div class="row">
            <div class="col-md-1">
                <div class="form-floating">
                    <select class="form-select" id="floatingSelect" aria-label="Items Per Page"
                            @onchange="OnPageCountChanged">
                        <option value="20">20</option>
                        <option value="50" selected>50</option>
                        <option value="100">100</option>
                    </select>
                    <label for="floatingSelect">Items Per Page</label>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalPreview" tabindex="-1" aria-labelledby="modalPreviewLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-body">
                    <div class="col-12 text-center">
                        <img src="@_currentImgUrl" class="img-fluid" alt="@_currentImgUrl"/>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="upload-alert" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <strong class="me-auto">Info</strong>
                <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">
                Upload has started. View progress <a href="/push">here</a>
            </div>
        </div>
    </div>
</AuthorizeView>

@code {
    private const int DefaultItemsPerPage = 50;
    private PaginationState _pagination = new PaginationState { ItemsPerPage = DefaultItemsPerPage };
    private FileSystemsDbContext _context = default!;
    private IJSObjectReference? _module;
    private StoragePath _mainStoragePath;
    private StorageLocation _mainStorageLocation = null!;
    private IReadOnlyList<StorageLocation> _storageLocations = null!;
    private string _currentImgUrl = string.Empty;
    private string _searchQuery = string.Empty;
    private long _uploadLimit = 0;
    private Guid _selectedStorageLocationId = Guid.Empty;
    private bool _shouldRender = true;

    /// <summary>
    /// The Items property in QuickGrid has an issue where multiple concurrent queries can be started:
    /// https://github.com/dotnet/aspnetcore/issues/58669
    ///
    /// Avoid this by writing a custom method <see cref="FilterFiles"/>
    /// </summary>
    private IQueryable<DotFile> FilteredFiles => _context.FilesThatStartWith(_searchQuery);

    protected override async Task OnInitializedAsync()
    {
        _context = await DbContextFactory.CreateDbContextAsync();
        _storageLocations = _context.StorageLocations.ToList();
        _mainStoragePath = await MainStorageProvider.GetMainStoragePath();
        _mainStorageLocation = await MainStorageProvider.GetMainStorageLocation();
    }

    protected override bool ShouldRender()
    {
        if (!_shouldRender)
        {
            _shouldRender = true;
            return false;
        }

        return base.ShouldRender();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Home.razor.js");
        }
    }

    /// <summary>
    /// This is used as the data source for the QuickGrid rather than the "Items=" property which has an issue:
    /// https://github.com/dotnet/aspnetcore/issues/58669
    ///
    /// Compare this to the Items property handler:
    /// https://github.com/dotnet/aspnetcore/blob/d310440534762a0a9b765c65a6711fbf81d5cbf0/src/Components/QuickGrid/Microsoft.AspNetCore.Components.QuickGrid/src/QuickGrid.razor.cs#L403
    ///
    /// The code is similar except it may use both synchronous or async (see _asyncQueryExecutor)
    /// </summary>
    /// <param name="request"></param>
    /// <returns></returns>
    public async ValueTask<GridItemsProviderResult<DotFile>> FilterFiles(GridItemsProviderRequest<DotFile> request)
    {
        await using var context = await DbContextFactory.CreateDbContextAsync();

        var query = context.FilesThatStartWith(_searchQuery);
        if (IsPageFilteredByStorageLocation())
        {
            query = context.UnsyncedFiles(query, _selectedStorageLocationId);
        }

        var totalCount = await query.CountAsync(request.CancellationToken);

        query = request.ApplySorting(query).Skip(request.StartIndex);
        if (request.Count.HasValue)
        {
            query = query.Take(request.Count.Value);
        }

        var items = await query.ToArrayAsync(request.CancellationToken);
        var result = new GridItemsProviderResult<DotFile>
        {
            Items = items,
            TotalItemCount = totalCount
        };

        return result;
    }

    private void OnPageCountChanged(ChangeEventArgs e)
    {
        var parsed = int.TryParse(e.Value?.ToString(), out var itemsPerPage);
        if (!parsed) itemsPerPage = DefaultItemsPerPage;
        _pagination.ItemsPerPage = itemsPerPage;
        StateHasChanged();
    }

    private void OnThumbnailClicked(MouseEventArgs e, string imagePath)
    {
        var thumbnailUrl = GetThumbnailUrl(imagePath);
        _currentImgUrl = thumbnailUrl;
        StateHasChanged();
    }

    private string GetThumbnailUrl(string imagePath)
    {
        return $"thumbnail?path={imagePath}";
    }

    private void ChangeStorageLocation(ChangeEventArgs e)
    {
        _selectedStorageLocationId = new Guid(e.Value!.ToString()!);
    }

    private bool IsPageFilteredByStorageLocation()
    {
        return _selectedStorageLocationId != Guid.Empty;
    }

    private async Task OnClickUpload(MouseEventArgs e)
    {
        if (!IsPageFilteredByStorageLocation())
        {
            return;
        }

        var destination = _storageLocations.First(x => x.Id == _selectedStorageLocationId);
        await JobComponent.JobManager.RunJob(new PushByStorageParameters(_mainStorageLocation, _searchQuery, _uploadLimit, destination));
    }

    // TODO: Move to DotFile
    private bool IsImage(string file)
    {
        var extension = Path.GetExtension(file).ToLowerInvariant();
        return Extensions.Contains(extension);
    }

    private static readonly IReadOnlyList<string> Extensions = new List<string>()
    {
        ".jpg", ".jpeg", ".png", ".heic", ".dng"
    }.ToImmutableList();

    public async ValueTask DisposeAsync() => await _context.DisposeAsync();

}