@page "/Verify"
@inject JobComponent JobComponent
@using System.ComponentModel.DataAnnotations
@using com.brettnamba.DotSync.FileSystem.Application.Jobs
@using com.brettnamba.DotSync.FileSystem.Application.Orchestration
@using com.brettnamba.DotSync.FileSystem.Domain.FileSystems.Enums
@using com.brettnamba.DotSync.FileSystem.Infrastructure.Jobs.Parameters
@using com.brettnamba.DotSync.FileSystem.WebApp.Components.Files
@using com.brettnamba.DotSync.FileSystem.WebApp.Components.Jobs
@using com.brettnamba.DotSync.FileSystem.WebApp.Components.Widgets
@using com.brettnamba.DotSync.FileSystem.WebApp.Startup
@using Microsoft.AspNetCore.Authorization
@implements IDisposable
@rendermode InteractiveServer
@attribute [Authorize(AuthenticationExtensions.VerifierPolicy)]

<div class="container">
    <h3>Verify</h3>
</div>

<div class="container">
    <EditForm Model="VerifyModel" OnSubmit="ExecuteVerify" FormName="Verify">
        <div class="input-group mb-3">
            <label class="input-group-text">Type</label>
            <InputSelect @bind-Value="VerifyModel!.Type" class="form-select">
                @foreach (var t in Enum.GetValues<StorageLocationType>())
                {
                    <option value="@t">@t</option>
                }
            </InputSelect>
        </div>
        <div class="mb-3">
            <label class="form-label">Storage Path:</label>
            <InputText @bind-Value="VerifyModel!.StoragePath" class="form-control"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Verify Path:</label>
            <FilePathInput @bind-Text="VerifyModel!.VerifyPath"/>
        </div>
        <div class="mb-3">
            <label class="form-label">Paths to Skip CSV:</label>
            <InputText @bind-Value="VerifyModel!.PathsToSkip" class="form-control"/>
        </div>
        <button type="submit" class="btn btn-primary">Submit</button>
    </EditForm>
</div>

<hr/>

<div class="container">
    <ProgressBar Value="@_progressPercent"/>
</div>
<div class="container">
    <JobProgress Messages="@_progressMessages"/>
</div>

<hr/>

<div class="container">
    <FileList FileResults="@_result"/>
</div>

@code {
    private const JobType JobId = JobType.Verify;

    [SupplyParameterFromForm(FormName = "Verify")]
    private VerifyForm? VerifyModel { get; set; }

    private double _progressPercent = 0;
    private readonly List<string> _progressMessages = new List<string>();
    private IReadOnlyList<FileResultList>? _result;
    private DateTime _startTime;

    protected override void OnInitialized()
    {
        JobComponent.OnInitialized();

        JobComponent.JobResultProvider.JobCompleted += ParseResult;
        JobComponent.ProgressReporter.LogReported += ReportProgressLog;
        JobComponent.ProgressReporter.PercentReported += ReportProgressPercent;

        VerifyModel ??= new VerifyForm()
        {
            Type = StorageLocationType.Local,
            StoragePath = JobComponent.DefaultLocalStorage
        };
    }

    private async Task ExecuteVerify()
    {
        _progressPercent = 0;
        JobComponent.Logger.LogInformation($"Verifying {VerifyModel!.StoragePath} {VerifyModel.VerifyPath}");
        _startTime = DateTime.UtcNow;
        await JobComponent.JobManager.RunJob(new VerifyParameters(VerifyModel.Type, VerifyModel.StoragePath, VerifyModel.VerifyPath, VerifyModel.PathsToSkip));
    }

    private void ParseResult(object? sender, JobResult data)
    {
        if (JobId != data.JobParameters.Type) return;
        if (data.JobParameters is not VerifyParameters)
        {
            throw new ArgumentException("Invalid parameters");
        }

        var jobParams = data.JobParameters as VerifyParameters;

        var files = data.Result is StorageLocationIntegrityVerificationResult ? (StorageLocationIntegrityVerificationResult)data.Result : default;
        _result = files.GenerateReport(jobParams!.StorageType.ToString(), jobParams.StoragePath!, jobParams.VerifyPath!, jobParams.PathsToSkip!, _startTime);

        InvokeAsync(StateHasChanged);
        _progressMessages.Clear();
    }

    private void ReportProgressLog(object? sender, ProgressLog log)
    {
        _progressMessages.Add(log.Message);
        InvokeAsync(StateHasChanged);
    }

    private void ReportProgressPercent(object? sender, ProgressPercent percent)
    {
        _progressPercent = percent.AsPercent();
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        JobComponent.JobResultProvider.JobCompleted -= ParseResult;
        JobComponent.ProgressReporter.LogReported -= ReportProgressLog;
        JobComponent.ProgressReporter.PercentReported -= ReportProgressPercent;
        JobComponent.Dispose();
    }

    public class VerifyForm
    {
        [Required, EnumDataType(typeof(StorageLocationType))]
        public StorageLocationType Type { get; set; }

        public string StoragePath { get; set; } = null!;
        public string VerifyPath { get; set; } = null!;
        public string PathsToSkip { get; set; } = null!;
    }

}