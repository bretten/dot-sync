<div class="overflow-auto progress-window log-font">
    @foreach (var msg in Messages ?? [])
    {
        @msg<br/>
    }
</div>
@if (AllowClear)
{
    <div class="container">
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="Clear">Clear</button>
    </div>
}

@code {
    [Parameter] public List<string>? Messages { get; set; }
    [Parameter] public bool AllowClear { get; set; }

    private void Clear() => Messages?.Clear();
}