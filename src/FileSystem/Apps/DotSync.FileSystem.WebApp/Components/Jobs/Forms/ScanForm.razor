@inject IJobManager JobManager
@inject IMainStorageProvider MainStorageProvider
@using com.brettnamba.DotSync.FileSystem.Application.Jobs
@using com.brettnamba.DotSync.FileSystem.Application.Storage
@using com.brettnamba.DotSync.FileSystem.Infrastructure.Jobs.Parameters
@inherits BaseForm

<MudForm @ref="Form" @bind-IsValid="IsValid" @bind-Errors="Errors">
    <MudGrid>
        <MudItem xs="12">
            <MudTextField T="string" Label="Path" Required="true" RequiredError="Path is required"
                          @bind-Value="ScanModel!.Path" OnBlur="@(() => Form.Validate())"/>
        </MudItem>
        <MudItem xs="12">
            <div class="d-flex align-center justify-space-between">
                @if (MudDialog != null)
                {
                    <MudButton ButtonType="ButtonType.Button" Variant="Variant.Filled" Color="Color.Primary"
                               Class="ml-auto" Disabled="@(!IsValid)" OnClick="@(() => Submit())">
                        Submit
                    </MudButton>
                }
                else
                {
                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                               Class="ml-auto" Disabled="@(!IsValid)">
                        Submit
                    </MudButton>
                }
            </div>
        </MudItem>
    </MudGrid>
</MudForm>
<MudGrid Class="mt-3 mb-3">
    <MudItem xs="3"></MudItem>
    <MudItem xs="6">
        @if (Errors.Any())
        {
            <MudAlert Severity="Severity.Error">
                @foreach (var error in Errors)
                {
                    <MudText Typo="Typo.subtitle1">@error</MudText>
                }
            </MudAlert>
        }
    </MudItem>
    <MudItem xs="3"></MudItem>
</MudGrid>

@code {

    [SupplyParameterFromForm(FormName = "Scan")]
    private ScanFormModel? ScanModel { get; set; }

    protected override async Task OnInitializedAsync()
    {
        ScanModel ??= new ScanFormModel()
        {
            Path = (await MainStorageProvider.GetMainStoragePath()).Value
        };
    }

    protected override Task Submit()
    {
        _ = Task.Run(() => JobManager.RunJob(new ScanParameters(ScanModel!.Path!)));
        return base.Submit();
    }

    public class ScanFormModel
    {
        public string? Path { get; set; }
    }

}