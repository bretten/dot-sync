@inject IJobManager JobManager
@inject IMainStorageProvider MainStorageProvider
@using com.brettnamba.DotSync.Common.Application.Jobs.Contracts
@using com.brettnamba.DotSync.FileSystem.Application.Storage
@using com.brettnamba.DotSync.FileSystem.Domain.FileSystems.Entities
@using com.brettnamba.DotSync.FileSystem.Infrastructure.Jobs.Parameters
@using com.brettnamba.DotSync.FileSystem.WebApp.Components.Files
@using com.brettnamba.DotSync.FileSystem.WebApp.Components.Widgets
@inherits BaseForm

<MudForm @ref="Form" @bind-IsValid="IsValid" @bind-Errors="Errors">
    <MudGrid>
        <MudItem xs="12">
            <FilePathInput @bind-Text="ScanModel.Path"/>
        </MudItem>
        <MudItem xs="12">
            <FormSubmitButton IsTypeButton="@(MudDialog != null)" IsDisabled="@(IsSubmitButtonDisabled())"
                              OnClick="@(Submit)"/>
        </MudItem>
    </MudGrid>
</MudForm>
<ErrorMessages Errors="Errors"/>

@code {

    [SupplyParameterFromForm(FormName = "Scan")]
    private ScanFormModel ScanModel { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        ScanModel = new ScanFormModel()
        {
            Source = await MainStorageProvider.GetMainStorageLocation()
        };
        await base.OnInitializedAsync();
    }

    /// <inheritdoc/>
    protected override Task OnSubmit()
    {
        _ = Task.Run(() => JobManager.RunJob(new ScanParameters(ScanModel.Source, ScanModel.Path)));
        return Task.CompletedTask;
    }

    public class ScanFormModel
    {
        public required StorageLocation Source { get; set; }
        public string? Path { get; set; }
    }

}