@using System.Collections.Concurrent
@using com.brettnamba.DotSync.Common.DateAndTme
@using com.brettnamba.DotSync.FileSystem.Application.Jobs
@using com.brettnamba.DotSync.FileSystem.Application.Jobs.Events
@using com.brettnamba.DotSync.FileSystem.WebApp.Components.Widgets
@inject IJobManager JobManager
@inject IJobProgressReporter ProgressReporter
@inject IDialogService DialogService
@inject IClock Clock

<MudThemeProvider/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudDataGrid Items="@_jobs" ExpandSingleRow="true">
    <Columns>
        <HierarchyColumn/>
        <PropertyColumn Property="x => x.Id" Sortable="false"/>
        <PropertyColumn Property="x => x.State">
            <CellTemplate Context="cell">
                @{
                    var icon = cell.Item.GetStateIcon();
                }
                <MudIcon Icon="@(icon.Item1)" Color="icon.Item2"/>
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.StartTime.ToLocalTime()" InitialDirection="SortDirection.Descending"/>
        <TemplateColumn Title="Progress" Sortable="false">
            <CellTemplate Context="cell">
                @(Math.Round(JobIdsToPercents[cell.Item!.Id], 2))%
            </CellTemplate>
        </TemplateColumn>
        <PropertyColumn Property="x => x.Type"/>
        <PropertyColumn Property="x => x.Duration" Sortable="false">
            <CellTemplate Context="cell">
                @(cell.Item.GetDurationString(Clock.GetUtcNow()))
            </CellTemplate>
        </PropertyColumn>
        <PropertyColumn Property="x => x.Parameters" Sortable="false">
            <CellTemplate Context="cell">
                @foreach (var pair in cell.Item.Parameters.AsKeyValuePairs())
                {
                    <span>
                        <b>@pair.Key</b>: @pair.Value
                    </span>
                    @:&nbsp;
                }
            </CellTemplate>
        </PropertyColumn>
        <TemplateColumn Title="Details">
            <CellTemplate Context="cell">
                <MudButton @onclick="@(e => HandleDialogOpen(e, cell.Item))" Variant="Variant.Filled"
                           Color="Color.Primary">
                    Details
                </MudButton>
            </CellTemplate>
        </TemplateColumn>
    </Columns>

    <ChildRowContent>
        <MudCard>
            <MudCardHeader Class="align-content-center">
                <CardHeaderContent>
                    <MudGrid>
                        <MudItem xs="3"></MudItem>
                        <MudItem xs="6">
                            <ProgressBar Value="@JobIdsToPercents[context.Item.Id]"/>
                        </MudItem>
                        <MudItem xs="3"></MudItem>
                    </MudGrid>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="overflow-scroll" Style="height: 5em">

            </MudCardContent>
            <MudCardContent Class="overflow-scroll" Style="height: 5em">

            </MudCardContent>
        </MudCard>
    </ChildRowContent>
</MudDataGrid>

@code {
    private IReadOnlyList<IJob> _jobs = null!;
    private static readonly ConcurrentDictionary<Guid, double> JobIdsToPercents = new ConcurrentDictionary<Guid, double>();
    private JobDetailsDialog? _activeDialog;

    protected override Task OnInitializedAsync()
    {
        _jobs = JobManager.Jobs;
        foreach (var job in _jobs)
        {
            if (!JobIdsToPercents.ContainsKey(job.Id))
            {
                JobIdsToPercents.TryAdd(job.Id, 0);
            }
        }

        JobManager.JobCreated += HandleNewJob;
        JobManager.JobCompleted += HandleJobComplete;
        JobManager.JobFailed += HandleJobFailed;

        ProgressReporter.PercentReported += ProgressReporterOnPercentReported;

        return base.OnInitializedAsync();
    }

    private void ProgressReporterOnPercentReported(object? sender, ProgressPercent e)
    {
        JobIdsToPercents.TryUpdate(e.JobId, e.AsPercent(), JobIdsToPercents[e.JobId]);
        _activeDialog?.UpdateProgress(e.AsPercent());

        InvokeAsync(StateHasChanged);
    }

    private void HandleNewJob(object? sender, IJob job)
    {
        JobIdsToPercents.TryAdd(job.Id, 0);
        InvokeAsync(StateHasChanged);
    }

    private void HandleJobComplete(object? sender, IJob job)
    {
        _activeDialog?.Finalize();
        InvokeAsync(StateHasChanged);
    }

    private void HandleJobFailed(object? sender, JobFailedArgs args)
    {
        _activeDialog?.Finalize();
        InvokeAsync(StateHasChanged);
    }

    private async Task HandleDialogOpen(MouseEventArgs obj, IJob job)
    {
        var parameters = new DialogParameters<JobDetailsDialog> { { x => x.Job, job }, { x => x.Progress, JobIdsToPercents[job.Id] } };
        var dialog = await DialogService.ShowAsync<JobDetailsDialog>("Job Details", parameters, new DialogOptions()
        {
            Position = DialogPosition.TopCenter,
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseButton = true
        });
        _activeDialog = (JobDetailsDialog)dialog.Dialog!;

        var result = await dialog.Result;
        _activeDialog = null;
    }

}