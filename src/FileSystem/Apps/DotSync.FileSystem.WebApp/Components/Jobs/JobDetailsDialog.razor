@using com.brettnamba.DotSync.Common.DateAndTme
@using com.brettnamba.DotSync.FileSystem.Application.Jobs
@using com.brettnamba.DotSync.FileSystem.WebApp.Components.Widgets
@inject IClock Clock

<MudDialog>
    <TitleContent>
        @{
            var icon = Job.GetStateIcon();
        }
        <MudIcon Icon="@(icon.Item1)" Color="icon.Item2" Class="d-inline"/>
        <MudText Typo="Typo.h6" Class="d-inline">Verify</MudText>
    </TitleContent>
    <DialogContent>
        <ProgressBar Value="@Progress"></ProgressBar>
        <MudGrid>
            <MudItem xs="6">
                <MudText Typo="Typo.h6">
                    Job ID
                    <MudText Typo="Typo.subtitle1" Class="ml-6">@(Job.Id.ToString("D"))</MudText>
                </MudText>
            </MudItem>
            <MudItem xs="6">
                <MudText Typo="Typo.h6">
                    Start Time
                    <MudText Typo="Typo.subtitle1" Class="ml-6">@Job.StartTime</MudText>
                </MudText>
            </MudItem>
            <MudItem xs="6">
                <MudText Typo="Typo.h6">
                    Duration
                    <MudText Typo="Typo.subtitle1" Class="ml-6">@Job.GetDurationString(Clock.GetUtcNow())</MudText>
                </MudText>
            </MudItem>
            <MudItem xs="6">
                <MudText Typo="Typo.h6">
                    End Time
                    <MudText Typo="Typo.subtitle1" Class="ml-6">@Job.EndTime</MudText>
                </MudText>
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.h6">
                    Parameters
                    <MudText Typo="Typo.subtitle1" Class="ml-6">
                        @foreach (var pair in Job.Parameters.AsKeyValuePairs())
                        {
                            <div>
                                <b>@pair.Key</b>: @pair.Value
                            </div>
                        }
                    </MudText>
                </MudText>
            </MudItem>
            <MudItem xs="12">
                <JobProgress Messages="@LogMessages"/>
            </MudItem>
        </MudGrid>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public IJob Job { get; set; } = null!;

    [Parameter] public double Progress { get; set; }

    [Parameter] public List<string> LogMessages { get; set; } = new List<string>();

    public void UpdateProgress(double progress)
    {
        Progress = progress;
        InvokeAsync(StateHasChanged);
    }

    public void UpdateLog(List<string> messages)
    {
        LogMessages = messages;
        InvokeAsync(StateHasChanged);
    }

    public void FinishJob()
    {
        InvokeAsync(StateHasChanged); // This updates the Job related data
        InvokeAsync(MudDialog.StateHasChanged); // This updates the title
    }
}