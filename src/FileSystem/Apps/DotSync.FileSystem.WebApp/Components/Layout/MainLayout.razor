@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu/>
    </div>

    <main>
        <article class="content px-4">
            <MudPaper Elevation="0" Width="100%" Class="d-flex justify-center align-center">
                <MudPaper Width="70%">
                    <MudThemeProvider/>
                    <MudPopoverProvider/>
                    <MudDialogProvider/>
                    <MudSnackbarProvider/>
                    @Body
                </MudPaper>
            </MudPaper>
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>