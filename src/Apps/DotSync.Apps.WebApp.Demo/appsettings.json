{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JobConfiguration": {
    "ReportPath": "/app/data/reports"
  },
  "Directories": {
    "SortDir": "ToSort"
  },
  "Thumbnails": {
    "Path": "/app/data/thumbnails",
    "MaxWidth": 1280
  },
  "OAuth2": {
    "Authority": "",
    "ClientId": "",
    "UserGroupsClaim": "cognito:groups",
    "AdminGroup": "Admins",
    "ViewerGroup": "Viewers"
  },
  "Aws": {
    "Region": "",
    "AccessKey": "",
    "SecretAccessKey": "",
    "S3": {
      "StorageClass": ""
    },
    "SecretsManager": {
      "SecretName": "",
      "Region": ""
    }
  },
  "Maintenance": {
    "Active": false,
    "LocalCheckpointFileBackfiller": {
      "CheckpointPath": "/app/data/maintenance/local_checkpoint/",
      "BatchCount": 1000
    }
  }
}
