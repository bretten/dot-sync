@using com.brettnamba.DotSync.Apps.Common.Components.Layout
@using com.brettnamba.DotSync.Apps.Common.Components.Pages
<Router AppAssembly="@(typeof(Program).Assembly)" AdditionalAssemblies="@(new [] { typeof(Home).Assembly })">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1"/>
    </Found>
</Router>