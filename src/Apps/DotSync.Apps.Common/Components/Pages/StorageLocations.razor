@page "/Storage"
@using com.brettnamba.DotSync.Apps.Common.Auth
@using com.brettnamba.DotSync.Apps.Common.Components.StorageLocations
@using com.brettnamba.DotSync.FileSystem.Domain.FileSystems.Entities
@using com.brettnamba.DotSync.FileSystem.Infrastructure.FileSystems.EntityFrameworkCore
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@rendermode InteractiveServer
@inject IDbContextFactory<FileSystemsDbContext> FileSystemsDbContextFactory
@inject IDialogService DialogService
@attribute [Authorize(AuthenticationExtensions.VerifierPolicy)]

<MudDataGrid Items="@_storageLocations">
    <ToolBarContent>
        <MudText Typo="Typo.h6">Storage Locations</MudText>
        <MudSpacer/>
        <MudChip T="string" Icon="@Icons.Material.Filled.Add" IconColor="Color.Surface" Color="Color.Primary"
                 OnClick="OnClickNew">
            New
        </MudChip>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x.Id" Sortable="false"/>
        <PropertyColumn Property="x => x.Type" Sortable="false"/>
        <PropertyColumn Property="x => x.Path.Value" Title="Path" Sortable="false"/>
    </Columns>
</MudDataGrid>

@code {
    private List<StorageLocation> _storageLocations = new List<StorageLocation>();

    protected override async Task OnInitializedAsync()
    {
        await using var setupDbContext = await FileSystemsDbContextFactory.CreateDbContextAsync();
        _storageLocations = await setupDbContext.StorageLocations.ToListAsync();
    }

    private async Task OnClickNew()
    {
        var parameters = new DialogParameters<NewStorageLocationDialog>()
        {
            { x => x.AllowLocal, false }
        };
        var dialog = await DialogService.ShowAsync<NewStorageLocationDialog>("New Storage Location", parameters, new DialogOptions()
        {
            Position = DialogPosition.TopCenter,
            FullWidth = true,
            MaxWidth = MaxWidth.Medium,
            CloseButton = true
        });

        var result = await dialog.Result;
        if (!result?.Canceled ?? false)
        {
            await using var dbContext = await FileSystemsDbContextFactory.CreateDbContextAsync();
            _storageLocations = await dbContext.StorageLocations.ToListAsync();
        }

        StateHasChanged();
    }

}
