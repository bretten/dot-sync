@using com.brettnamba.DotSync.Apps.Common.Auth
@implements IDisposable
@inject NavigationManager Navigation

<AuthorizeView Context="authContext">
    <Authorized>
        <MudMenuItem Icon="@Icons.Material.Filled.AccountCircle">@authContext.GetUsername()</MudMenuItem>
        <MudMenuItem Icon="@Icons.Material.Filled.Logout" Href="@($"logout?returnUrl={_currentUrl}")">
            Logout
        </MudMenuItem>
    </Authorized>
    <NotAuthorized>
        <MudMenuItem Icon="@Icons.Material.Filled.Login" Href="login">Login</MudMenuItem>
    </NotAuthorized>
</AuthorizeView>

@code {
    private string? _currentUrl;

    protected override void OnInitialized()
    {
        _currentUrl = Navigation.Uri;
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = Navigation.Uri;
        StateHasChanged();
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}