@using com.brettnamba.DotSync.Common.Application.Jobs.Execution
@rendermode InteractiveServer

@if (JobResults.Results.Count == 0)
{
  <b>No result</b>
}
else
{
  <MudStack>
    <MudGrid>
      <MudItem xs="12">
        <MudList T="string">
          @foreach (var resultCollection in JobResults.Results.Where(x => x.Value.IsOnlyCount))
          {
            <MudListItem>@(resultCollection.Key): @(resultCollection.Value.Count.ToString())</MudListItem>
          }
        </MudList>
      </MudItem>
      <MudItem xs="12">
        <MudExpansionPanels>
          @foreach (var resultCollection in JobResults.Results.Where(x => !x.Value.IsOnlyCount))
          {
            var resultName = resultCollection.Key;
            var result = resultCollection.Value;
            var items = result.Items;

            <MudExpansionPanel Text="@($"{resultName} ({result.Count})")" Disabled="@(items.Count == 0)">
              <MudSimpleTable>
                <tbody>
                @foreach (var item in items)
                {
                  <tr>
                    @foreach (var dataPoint in item) // Print out each data point
                    {
                      <td>@dataPoint</td>
                    }
                  </tr>
                }
                </tbody>
              </MudSimpleTable>
            </MudExpansionPanel>
          }
        </MudExpansionPanels>
      </MudItem>
    </MudGrid>
  </MudStack>
}

@code {
  [Parameter] public required JobResults JobResults { get; set; }
}