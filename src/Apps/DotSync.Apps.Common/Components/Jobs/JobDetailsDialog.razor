@inject IJobManager JobManager
@inject IJobProgressReporter ProgressReporter
@using com.brettnamba.DotSync.Apps.Common.Components.Widgets
@using com.brettnamba.DotSync.Common.Application.Jobs.Contracts
@using com.brettnamba.DotSync.Common.Application.Jobs.Events
@using com.brettnamba.DotSync.Common.Application.Jobs.Progress
@implements IDisposable
<MudDialog>
    <TitleContent>
        @{
            var icon = Job.GetStateIcon();
        }
        <MudIcon Icon="@(icon.Item1)" Color="icon.Item2" Class="d-inline"/>
        <MudText Typo="Typo.h6" Class="d-inline">@(Job.Type)</MudText>
    </TitleContent>
    <DialogContent>
        <ProgressBar Value="@Progress"/>
        <JobDetails Job="@Job"/>
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.h6">Logs</MudText>
                <MudPaper Class="pa-3">
                    <JobProgress Messages="@LogMessages"/>
                </MudPaper>
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.h6">Result</MudText>
                <div class="pa-3">
                    @if (JobOutput != null)
                    {
                        if (JobOutput.Exception == null)
                        {
                            <JobResult JobResults="@JobOutput.JobResults"/>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Error">@JobOutput.Exception!.Message</MudAlert>
                        }
                    }
                </div>
            </MudItem>
        </MudGrid>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter] public IJob Job { get; set; } = null!;

    [Parameter] public double Progress { get; set; }

    [Parameter] public IReadOnlyList<string> LogMessages { get; set; } = new List<string>();

    [Parameter] public IJobOutput? JobOutput { get; set; }

    protected override void OnInitialized()
    {
        Progress = JobManager.CheckJobProgress(Job.Id)?.AsPercent() ?? 0;
        LogMessages = JobManager.GetJobLogs(Job.Id);
        JobOutput = JobManager.GetJobOutput(Job.Id);

        JobManager.JobCompleted += HandleJobComplete;
        JobManager.JobFailed += HandleJobFailed;

        ProgressReporter.LogReported += HandleLogReported;
        ProgressReporter.PercentReported += HandlePercentReported;
        base.OnInitialized();
    }

    public void UpdateProgress(double progress)
    {
        Progress = progress;
        InvokeAsync(StateHasChanged);
    }

    public void UpdateLogs(IReadOnlyList<string> messages)
    {
        LogMessages = messages;
        InvokeAsync(StateHasChanged);
    }

    public void FinishJob(IJobOutput jobOutput)
    {
        JobOutput = jobOutput;
        FinishJob();
    }

    public void FinishJob()
    {
        InvokeAsync(StateHasChanged); // This updates the Job related data
        InvokeAsync(MudDialog.StateHasChanged); // This updates the title
    }

    private void HandlePercentReported(object? sender, ProgressPercent e)
    {
        if (e.JobId == Job.Id) UpdateProgress(e.AsPercent());
    }

    private void HandleLogReported(object? sender, ProgressLog e)
    {
        if (e.JobId == Job.Id) UpdateLogs(JobManager.GetJobLogs(e.JobId).ToList());
    }

    private void HandleJobComplete(object? sender, JobCompletedArgs args)
    {
        if (args.Job.Id == Job.Id) FinishJob(args.Result);
    }

    private void HandleJobFailed(object? sender, JobFailedArgs args)
    {
        if (args.Job.Id == Job.Id) FinishJob();
    }

    public void Dispose()
    {
        JobManager.JobCompleted -= HandleJobComplete;
        JobManager.JobFailed -= HandleJobFailed;

        ProgressReporter.LogReported -= HandleLogReported;
        ProgressReporter.PercentReported -= HandlePercentReported;
    }

}