@inject IStorageLocationRepository StorageLocationRepo
@using com.brettnamba.DotSync.Apps.Common.Components.Widgets
@using com.brettnamba.DotSync.Common.Application.Jobs.Contracts
@using com.brettnamba.DotSync.FileSystem.Domain.FileSystems.Repositories
@using com.brettnamba.DotSync.FileSystem.Infrastructure.Jobs.Parameters
@inherits BaseJobForm

<MudForm @ref="Form" @bind-IsValid="IsValid" @bind-Errors="Errors">
    <MudGrid>
        <MudItem xs="12">
            <FormSubmitButton IsTypeButton="@(MudDialog != null)" IsDisabled="@(IsSubmitButtonDisabled())"
                              OnClick="@(Submit)"/>
        </MudItem>
    </MudGrid>
</MudForm>
<ErrorMessages Errors="Errors"/>

@code {

    /// <inheritdoc/>
    protected override async Task<IJobParameters> GetJobParameters()
    {
        const string sourcePath = "";
        var mainStorage = await StorageLocationRepo.GetMainStorageLocation();
        var destinationPath = mainStorage.Path.Value;
        var parameters = new SortParameters(sourcePath, destinationPath);
        return parameters;
    }

    /// <inheritdoc/>
    protected override async Task OnSubmit()
    {
        var jobParameters = await GetJobParameters();
        _ = Task.Run(() => JobManager.RunJob((SortParameters)jobParameters));
    }

}