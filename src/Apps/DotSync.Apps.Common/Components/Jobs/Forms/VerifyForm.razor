@using com.brettnamba.DotSync.Apps.Common.Components.Files
@using com.brettnamba.DotSync.Apps.Common.Components.StorageLocations
@using com.brettnamba.DotSync.Apps.Common.Components.Widgets
@using com.brettnamba.DotSync.Common.Application.Jobs.Contracts
@using com.brettnamba.DotSync.FileSystem.Domain.FileSystems.Entities
@using com.brettnamba.DotSync.FileSystem.Infrastructure.Jobs.Parameters
@inherits BaseJobForm

<MudForm @ref="Form" @bind-IsValid="IsValid" @bind-Errors="Errors">
    <MudGrid>
        <MudItem xs="12">
            <StorageLocationSelect IncludeAllStorages="true" @bind-StorageLocation="VerifyModel.Source"/>
        </MudItem>
        <MudItem xs="12">
            <FilePathInput @bind-Text="VerifyModel.Path"/>
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string" Label="Paths to Skip CSV:" @bind-Value="VerifyModel!.PathsToSkip"/>
        </MudItem>
        <MudItem xs="12">
            <FormSubmitButton IsTypeButton="@(MudDialog != null)" IsDisabled="@(IsSubmitButtonDisabled())"
                              OnClick="@(Submit)"/>
        </MudItem>
    </MudGrid>
</MudForm>
<ErrorMessages Errors="Errors"/>

@code {

    [SupplyParameterFromForm(FormName = "Verify")]
    private VerifyFormModel VerifyModel { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        VerifyModel = new VerifyFormModel();
        await base.OnInitializedAsync();
    }

    /// <inheritdoc/>
    protected override Task<IJobParameters> GetJobParameters()
    {
        return Task.FromResult<IJobParameters>(new VerifyParameters(VerifyModel.Source!, VerifyModel.Path, VerifyModel.PathsToSkip));
    }

    /// <inheritdoc/>
    protected override async Task OnSubmit()
    {
        var jobParameters = await GetJobParameters();
        _ = Task.Run(() => JobManager.RunJob((VerifyParameters)jobParameters));
    }

    public class VerifyFormModel
    {
        public StorageLocation? Source { get; set; }

        public string? Path { get; set; }
        public string? PathsToSkip { get; set; }
    }

}